# Copy to .env and fill in. .env is git-ignored.

# AI estimate (pick one provider)
PROVIDER=gemini                    # gemini | claude
GEMINI_API_KEY=                    # aistudio.google.com
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=                 # console.anthropic.com (optional)
CLAUDE_MODEL=claude-haiku-5-5

# Optional hint for the estimator, e.g. "Melbourne, Australia; often Malaysian food"
FOOD_CONTEXT=

# Cronometer login (use a test account while trying this out)
CRONO_EMAIL=
CRONO_PASSWORD=

